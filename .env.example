# n8n Configuration
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
# For local webhooks, keep localhost. For Telegram callback queries, use a tunnel like ngrok or cloudflared
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=UTC

# Vercel AI Gateway Configuration
# Vercel AI Gateway endpoint: https://api.gateway.vercel.com/v1 (or your custom proxy URL)
VERCEL_AI_GATEWAY_URL=https://api.gateway.vercel.com/v1
VERCEL_AI_GATEWAY_API_KEY=your_vercel_ai_gateway_key_here
DEFAULT_AI_MODEL=anthropic/claude-3-5-sonnet

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
